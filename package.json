{
  "name": "cloudbrain",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/sync-d1-id.mjs && npm run build -w @cloudbrain/web && wrangler dev",
    "dev:web": "cd web && npm run dev",
    "build": "node scripts/sync-d1-id.mjs && cd web && npm run build",
    "typecheck": "tsc --noEmit",
    "deploy": "npm run build && node scripts/check-d1-id.mjs && wrangler deploy",
    "db:local": "wrangler d1 execute cloudbrain --local --file=./schema.sql",
    "db:remote": "node scripts/check-d1-id.mjs && wrangler d1 execute cloudbrain --remote --file=./schema.sql",
    "sync:d1": "node scripts/sync-d1-id.mjs",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@cloudbrain/integrations": "*",
    "@cloudbrain/shared": "*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260901.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "wrangler": "^4.24.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
