# CloudBrain 2.0 Configuration
# Copy to .env and fill in your values

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=cloudbrain
DB_PASSWORD=
DB_NAME=cloudbrain

# Cloudflare
CF_ACCOUNT_ID=
CF_API_TOKEN=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=

# Discord (optional)
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=

# WhatsApp (optional)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# Search (optional - DuckDuckGo works without key)
BING_SEARCH_KEY=

# Server
PORT=3000
