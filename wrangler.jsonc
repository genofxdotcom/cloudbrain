{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloudbrain",
  "main": "src/index.ts",
  "compatibility_date": "2025-05-05",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "web/dist",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cloudbrain",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ARTIFACTS",
      "bucket_name": "cloudbrain-artifacts"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "REALTIME",
        "class_name": "RealtimeHub"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RealtimeHub"]
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "triggers": {
    "crons": ["* * * * *"]
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "APP_NAME": "CloudBrain"
  }
  /*
  ── Secrets (server-only; set with `wrangler secret put` or dashboard) ──
  COMPOSIO_API_KEY        — Composio BYOK key; enables integrations (optional)
  OPENAI_API_KEY          — optional, enables OpenAI models
  ANTHROPIC_API_KEY       — optional, enables Anthropic models
  GEMINI_API_KEY          — optional, enables Gemini models
  GROQ_API_KEY            — optional
  OPENROUTER_API_KEY      — optional

  ── Identity ──────────────────────────────────────────────────────────────
  Authentication is handled externally (e.g. Cloudflare Access in front of
  the deployment). This Worker only reads the identity email header the
  proxy sets: cf-access-authenticated-user-email (or x-forwarded-email).
  Local dev without a proxy maps to a single shared user automatically.

  Local dev: copy .dev.vars.example to .dev.vars
  */
}
